{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://press.gcim.eu/schemas/news-publication.schema.json",
  "title": "GCIM Press Office publication",
  "type": "object",
  "required": [
    "id",
    "slug",
    "date",
    "category",
    "sourceLanguage",
    "featured",
    "translations",
    "translationStatus"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "release",
        "statement",
        "coordinator-action",
        "perspective"
      ]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "release",
          "statement",
          "coordinator-action",
          "perspective"
        ]
      }
    },
    "translations": {
      "type": "object",
      "required": [
        "en",
        "ar",
        "es",
        "zh",
        "ru",
        "fr",
        "uk"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "$ref": "#/$defs/translation"
        },
        "ar": {
          "$ref": "#/$defs/translation"
        },
        "es": {
          "$ref": "#/$defs/translation"
        },
        "zh": {
          "$ref": "#/$defs/translation"
        },
        "ru": {
          "$ref": "#/$defs/translation"
        },
        "fr": {
          "$ref": "#/$defs/translation"
        },
        "uk": {
          "$ref": "#/$defs/translation"
        }
      }
    },
    "translationStatus": {
      "type": "object",
      "required": [
        "en",
        "ar",
        "es",
        "zh",
        "ru",
        "fr",
        "uk"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved"
          ]
        },
        "ar": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved"
          ]
        },
        "es": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved"
          ]
        },
        "zh": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved"
          ]
        },
        "ru": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved"
          ]
        },
        "fr": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved"
          ]
        },
        "uk": {
          "type": "string",
          "enum": [
            "draft",
            "review",
            "approved"
          ]
        }
      },
      "description": "Publication visibility status for every language. A publication is public only when all seven values are 'approved'."
    },
    "sourceLanguage": {
      "type": "string",
      "const": "ru",
      "description": "Authoritative source language of every GCIM Press Office publication. The Russian version in translations.ru is the source text for translation."
    },
    "featured": {
      "type": "boolean",
      "description": "Manual editorial flag for the single publication selected for the Featured block. It is independent of publication date."
    }
  },
  "$defs": {
    "translation": {
      "type": "object",
      "required": [
        "title",
        "body",
        "serviceInfo",
        "links",
        "attachments"
      ],
      "additionalProperties": false,
    "properties": {
      "title": {
        "type": "string"
      },
      "categoryLabel": {
        "type": "string"
      },
      "body": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bodyBlock"
          }
        },
        "serviceInfo": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "attachments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "format": {
                "type": "string"
              },
              "size": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "bodyBlock": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "paragraph"
            },
        "text": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "heading"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "quote"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false
        }
      ]
    },
    "publishedBodyBlock": {
      "type": "object",
      "required": [
        "type"
      ],
      "oneOf": [
        {
          "properties": {
            "type": {
              "const": "paragraph"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "heading"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "quote"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "required": [
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "type": {
              "const": "list"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "required": [
            "type",
            "items"
          ],
          "additionalProperties": false
        }
      ]
    },
    "publishedTranslation": {
      "type": "object",
      "required": [
        "title",
        "body",
        "serviceInfo",
        "links",
        "attachments"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/publishedBodyBlock"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "translationStatus": {
            "type": "object",
            "properties": {
              "en": {
                "const": "approved"
              },
              "ar": {
                "const": "approved"
              },
              "es": {
                "const": "approved"
              },
              "zh": {
                "const": "approved"
              },
              "ru": {
                "const": "approved"
              },
              "fr": {
                "const": "approved"
              },
              "uk": {
                "const": "approved"
              }
            },
            "required": [
              "en",
              "ar",
              "es",
              "zh",
              "ru",
              "fr",
              "uk"
            ]
          }
        },
        "required": [
          "translationStatus"
        ]
      },
      "then": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "slug": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date"
          },
          "translations": {
            "type": "object",
            "properties": {
              "en": {
                "$ref": "#/$defs/publishedTranslation"
              },
              "ar": {
                "$ref": "#/$defs/publishedTranslation"
              },
              "es": {
                "$ref": "#/$defs/publishedTranslation"
              },
              "zh": {
                "$ref": "#/$defs/publishedTranslation"
              },
              "ru": {
                "$ref": "#/$defs/publishedTranslation"
              },
              "fr": {
                "$ref": "#/$defs/publishedTranslation"
              },
              "uk": {
                "$ref": "#/$defs/publishedTranslation"
              }
            },
            "required": [
              "en",
              "ar",
              "es",
              "zh",
              "ru",
              "fr",
              "uk"
            ]
          }
        }
      }
    }
  ]
}
